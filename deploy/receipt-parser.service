[Unit]
Description=Business Automations Receipt Parser
After=network.target

[Service]
Type=simple
User=automation
WorkingDirectory=/opt/business-automations
Environment=NODE_ENV=production
EnvironmentFile=/opt/business-automations/.env
ExecStart=/usr/bin/npm run receipt-parser
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
